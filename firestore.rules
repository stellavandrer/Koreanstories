// Règles Firestore — Korean Stories
// À copier-coller dans Firebase Console → Firestore Database → Rules
// (ou déployer via la CLI : `firebase deploy --only firestore:rules`)
//
// Trois collections :
//   /users/{userId}        → données privées (snapshot localStorage, XP, etc.)
//                            chacun lit/écrit UNIQUEMENT les siennes.
//   /leaderboard/{userId}  → mini-profil public opt-in (pseudo + xp + avatar).
//                            tout membre connecté peut LIRE ;
//                            chacun n'écrit que SA ligne, au format strict.
//   /reviews/{reviewId}    → avis laissés par les visiteurs (avis.html).
//                            n'importe qui peut CRÉER un avis (pas de compte
//                            requis) ; la modération (pending → approved) se
//                            fait manuellement via la Console Firebase, pas
//                            depuis le site — aucune règle "update" côté
//                            client, donc impossible de s'auto-approuver.
//
// Durcissement (2026-07-04) : liste blanche de champs, types stricts, valeurs
// non négatives et plafonnées, uid == ID du document (anti-usurpation),
// horodatage = heure serveur (anti-antidatage). Toute collection non listée
// est refusée par défaut.
//
// Limite assumée : xp/streak sont déclarés par le client (pas de vérité
// serveur), donc un utilisateur technique peut gonfler SON PROPRE score dans
// les bornes autorisées. Il ne peut PAS toucher au score des autres ni rien
// casser. Un anti-triche total nécessiterait des Cloud Functions.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Données privées ──────────────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // ── Classement public (opt-in) ───────────────────────
    match /leaderboard/{userId} {

      // Tout membre connecté peut LIRE la liste.
      allow read: if request.auth != null;

      // Création / mise à jour : uniquement sa propre ligne, au format strict.
      allow create, update: if request.auth != null
        && request.auth.uid == userId

        // Aucun champ hors de cette liste blanche.
        && request.resource.data.keys().hasOnly(
             ['uid', 'name', 'xp', 'streak', 'avatar', 'updatedAt'])

        // Identité : le champ uid doit correspondre à l'ID du document.
        && request.resource.data.uid == userId

        // Pseudo : chaîne non vide, 40 caractères max.
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 40

        // XP : entier, entre 0 et 10 000 000.
        && request.resource.data.xp is int
        && request.resource.data.xp >= 0
        && request.resource.data.xp <= 10000000

        // Streak : entier, entre 0 et 10 000.
        && request.resource.data.streak is int
        && request.resource.data.streak >= 0
        && request.resource.data.streak <= 10000

        // Avatar : soit null, soit un objet structuré (jamais du texte libre).
        && (request.resource.data.avatar == null
            || request.resource.data.avatar is map)

        // Horodatage : doit être l'heure serveur (FieldValue.serverTimestamp()).
        && request.resource.data.updatedAt == request.time;

      // Suppression : seulement par le propriétaire (opt-out).
      allow delete: if request.auth != null
                    && request.auth.uid == userId;
    }

    // ── Avis publics (avis.html) ─────────────────────────
    match /reviews/{reviewId} {

      // Lecture publique : uniquement les avis approuvés ET rendus publics
      // par leur auteur — jamais les avis privés ni en attente de modération.
      allow read: if resource.data.public == true
                  && resource.data.status == 'approved';

      // Création : compte requis, au format strict.
      //
      // Durcissement (2026-08-05) : la création était ouverte à n'importe qui,
      // sans compte. Les règles Firestore ne savent pas limiter le débit : un
      // script pouvait donc insérer des milliers d'avis « pending ». Ils
      // n'auraient jamais été publics (status forcé à 'pending'), mais ils
      // auraient noyé la modération et gonflé la facture Firestore.
      // Le site demandant désormais une inscription pour apprendre, exiger un
      // compte ici est cohérent — et un avis écrit par quelqu'un qui apprend
      // vraiment vaut mieux qu'un avis anonyme.
      // On ne stocke volontairement PAS l'uid : l'authentification sert de
      // barrière à l'écriture, le document lui-même reste anonyme.
      allow create: if request.auth != null
        // Aucun champ hors de cette liste blanche.
        && request.resource.data.keys().hasOnly(
          ['name', 'rating', 'comment', 'public', 'status', 'createdAt'])

        // Prénom : chaîne non vide, 40 caractères max.
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 40

        // Note : entier entre 1 et 5.
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5

        // Commentaire : chaîne, 500 caractères max (peut être vide).
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 500

        // Visibilité : booléen déclaré par l'auteur.
        && request.resource.data.public is bool

        // Statut : toujours "pending" à la création — impossible de
        // s'auto-approuver, seule la Console Firebase peut changer ce champ.
        && request.resource.data.status == 'pending'

        // Horodatage : doit être l'heure serveur (FieldValue.serverTimestamp()).
        && request.resource.data.createdAt == request.time;

      // Aucune mise à jour ni suppression depuis le client — la modération
      // se fait exclusivement via la Console Firebase (Admin SDK, hors règles).
    }

    // Tout le reste : refusé par défaut.
  }
}
